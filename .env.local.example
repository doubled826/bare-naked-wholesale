# Email routing
ORDER_EMAIL_TO=info@barenakedpet.com
ORDER_EMAIL_FROM=orders@barenakedpet.com
PORTAL_EMAIL_FROM=support@barenakedpet.com
REPLY_TO_EMAIL=info@barenakedpet.com
RESEND_API_KEY=your-resend-api-key

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
NEXT_PUBLIC_APP_URL=https://your-app-url.example.com
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# SMTP
# Optional fallback when RESEND_API_KEY is not configured
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
